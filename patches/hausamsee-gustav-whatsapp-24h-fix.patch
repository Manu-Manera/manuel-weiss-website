+/** Kurzüberblick der letzten Garten-Läufe (für Catch-up nach 24h-Block). */
+async function buildGartenCatchupWhatsApp() {
+  try {
+    const snap = await db.doc("config/gartenPlan").get();
+    if (!snap.exists) return "";
+    const data = snap.data() || {};
+    const ymd = gartenYmdZurichNow();
+    const ymdPrev = gartenYmdDaysAgo(ymd, 1);
+    const lines = [];
+    for (const day of [ymd, ymdPrev]) {
+      const dayLog = normalizeGartenWaterLogDay(data.waterLog?.[day]);
+      const entries = Object.values(dayLog || {}).filter(
+        (e) => e && (e.status === "started" || e.status === "done" || e.status === "skipped_rain")
+      );
+      if (!entries.length) continue;
+      const label = day === ymd ? "Heute" : "Gestern";
+      lines.push(`*${label} (${day}):*`);
+      for (const e of entries) {
+        const zone = e.zoneLabel || e.zoneId || "Zone";
+        if (e.status === "skipped_rain") {
+          lines.push(`• ${zone}: übersprungen (Regen)`);
+        } else {
+          const slot = e.slotOn && e.slotOff ? ` ${e.slotOn}–${e.slotOff}` : "";
+          const mins = e.minutes != null ? ` · ${e.minutes} Min` : "";
+          lines.push(`• ${zone}:${slot}${mins} · ${e.status}`);
+        }
+      }
+    }
+    if (!lines.length) return "";
+    return `🌿 *Garten-Überblick*\n\n${lines.join("\n")}`;
+  } catch (e) {
+    logger.warn("buildGartenCatchupWhatsApp", e?.message || e);
+    return "";
+  }
+}
