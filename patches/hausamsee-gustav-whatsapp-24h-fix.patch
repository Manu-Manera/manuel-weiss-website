-async function broadcast(text) {
+/* ==========================================================================
+   WhatsApp 24h-Fenster: Sessions, Pending-Queue, Delivery-Status
+   Meta liefert bei Textnachrichten oft HTTP 200, scheitert danach mit #131047
+   wenn der Empfänger Gustav >24h nicht geschrieben hat.
+   ========================================================================== */
+
+const WA_SESSION_COLLECTION = "whatsapp_sessions";
+const WA_PENDING_COLLECTION = "whatsapp_pending";
+const WA_OUTBOUND_COLLECTION = "whatsapp_outbound";
+/** Sicherheitsmarge unter 24h, damit Randfälle nicht knappen. */
+const WA_WINDOW_MS = 23 * 60 * 60 * 1000;
+const WA_PENDING_MAX_FLUSH = 15;
+const WA_OUTBOUND_TTL_MS = 48 * 60 * 60 * 1000;
+
+function normWaPhone(s) {
+  return String(s || "").replace(/\D/g, "");
+}
+
+async function touchWhatsAppSession(phone) {
+  const id = normWaPhone(phone);
+  if (!id) return;
+  try {
+    await db.collection(WA_SESSION_COLLECTION).doc(id).set(
+      {
+        lastInboundAt: FieldValue.serverTimestamp(),
+        updatedAt: FieldValue.serverTimestamp(),
+      },
+      { merge: true }
+    );
+  } catch (e) {
+    logger.warn("touchWhatsAppSession", e?.message || e);
+  }
+}
+
+async function getWhatsAppLastInboundMs(phone) {
+  const id = normWaPhone(phone);
+  if (!id) return 0;
+  try {
+    const snap = await db.collection(WA_SESSION_COLLECTION).doc(id).get();
+    const t = snap.data()?.lastInboundAt;
+    return t?.toMillis?.() || 0;
+  } catch (e) {
+    logger.warn("getWhatsAppLastInboundMs", e?.message || e);
+    return 0;
+  }
+}
+
+async function isWithinWhatsAppWindow(phone) {
+  const last = await getWhatsAppLastInboundMs(phone);
+  return !!last && Date.now() - last < WA_WINDOW_MS;
+}
+
+async function enqueuePendingWhatsApp(to, text, meta = {}) {
+  const phone = normWaPhone(to);
+  if (!phone || !text) return;
+  try {
+    await db.collection(WA_PENDING_COLLECTION).add({
+      to: phone,
+      text: String(text).slice(0, 4000),
+      meta: meta || {},
+      delivered: false,
+      createdAt: FieldValue.serverTimestamp(),
+    });
+    await debugLog("wa_pending_enqueue", {
+      to: phone,
+      reason: meta?.reason || null,
+      preview: String(text).slice(0, 100),
+    });
+  } catch (e) {
+    logger.warn("enqueuePendingWhatsApp", e?.message || e);
+  }
+}
+
+async function rememberWhatsAppOutbound(messageId, to, text) {
+  const id = String(messageId || "").trim();
+  const phone = normWaPhone(to);
+  if (!id || !phone || !text) return;
+  try {
+    await db.collection(WA_OUTBOUND_COLLECTION).doc(id).set({
+      to: phone,
+      text: String(text).slice(0, 4000),
+      createdAt: FieldValue.serverTimestamp(),
+      expiresAtMs: Date.now() + WA_OUTBOUND_TTL_MS,
+    });
+  } catch (e) {
+    logger.warn("rememberWhatsAppOutbound", e?.message || e);
+  }
+}
+
+async function handleWhatsAppStatusFailure(status) {
+  const code = status?.errors?.[0]?.code ?? null;
+  if (code !== 131047 && code !== 131026) return;
+  const wamid = String(status?.id || "").trim();
+  const to = normWaPhone(status?.recipient_id);
+  if (!wamid || !to) return;
+  try {
+    const ref = db.collection(WA_OUTBOUND_COLLECTION).doc(wamid);
+    const snap = await ref.get();
+    if (!snap.exists) {
+      await debugLog("wa_status_failed_no_outbound", { to, wamid, metaCode: code });
+      return;
+    }
+    const text = snap.data()?.text;
+    await enqueuePendingWhatsApp(to, text, { reason: `status_${code}`, wamid });
+    await ref.delete().catch(() => {});
+    await debugLog("wa_status_requeued", { to, wamid, metaCode: code });
+  } catch (e) {
+    logger.warn("handleWhatsAppStatusFailure", e?.message || e);
+  }
+}
+
+async function flushPendingWhatsApp(to, phoneIdOpt) {
+  const phone = normWaPhone(to);
+  if (!phone) return { flushed: 0 };
+  let snap;
+  try {
+    snap = await db
+      .collection(WA_PENDING_COLLECTION)
+      .where("to", "==", phone)
+      .where("delivered", "==", false)
+      .limit(40)
+      .get();
+  } catch (e) {
+    logger.warn("flushPendingWhatsApp query", e?.message || e);
+    return { flushed: 0 };
+  }
+  if (snap.empty) return { flushed: 0 };
+
+  const docs = snap.docs
+    .slice()
+    .sort((a, b) => (a.data().createdAt?.toMillis?.() || 0) - (b.data().createdAt?.toMillis?.() || 0))
+    .slice(0, WA_PENDING_MAX_FLUSH);
+
+  let flushed = 0;
+  for (const doc of docs) {
+    const text = doc.data()?.text;
+    if (!text) {
+      await doc.ref.update({ delivered: true, droppedAt: FieldValue.serverTimestamp() }).catch(() => {});
+      continue;
+    }
+    const sent = await sendWhatsAppDetailed(phone, text, phoneIdOpt);
+    if (!sent.ok) {
+      await debugLog("wa_pending_flush_failed", { to: phone, metaCode: sent.metaCode, reason: sent.reason });
+      break;
+    }
+    if (sent.messageId) await rememberWhatsAppOutbound(sent.messageId, phone, text);
+    await doc.ref.update({
+      delivered: true,
+      deliveredAt: FieldValue.serverTimestamp(),
+      messageId: sent.messageId || null,
+    }).catch(() => {});
+    flushed += 1;
+  }
+  if (flushed) {
+    logger.info(`WhatsApp-Pending nachgeliefert: ${flushed} an ${phone}`);
+    await debugLog("wa_pending_flushed", { to: phone, flushed });
+  }
+  return { flushed };
+}
+
+/**
+ * Proaktive Nachricht (Garten-Plan, Regen-Skip, Reminder, …).
+ * Bekannt ausserhalb 24h-Fenster → Queue (oder optionales Template).
+ * Unbekanntes/offenes Fenster → senden; #131047 kommt per Status-Webhook in die Queue.
+ */
+async function sendWhatsAppProactive(to, text, phoneIdOpt, meta = {}) {
+  const phone = normWaPhone(to);
+  if (!phone || !text) return { ok: false, reason: "missing_to_or_text" };
+
+  const lastInboundMs = await getWhatsAppLastInboundMs(phone);
+  const sessionKnown = lastInboundMs > 0;
+  const inWindow = sessionKnown && Date.now() - lastInboundMs < WA_WINDOW_MS;
+
+  if (sessionKnown && !inWindow) {
+    const templateName = (process.env.WHATSAPP_TEMPLATE_GARTEN || "").trim();
+    if (templateName && meta?.templateParams) {
+      const tr = await sendWhatsAppTemplate(phone, templateName, meta.templateParams, phoneIdOpt);
+      if (tr.ok) return tr;
+    }
+    await enqueuePendingWhatsApp(phone, text, {
+      ...meta,
+      reason: meta?.reason || "outside_24h_window",
+    });
+    return { ok: false, queued: true, reason: "outside_24h_window", metaCode: 131047 };
+  }
+
+  const sent = await sendWhatsAppDetailed(phone, text, phoneIdOpt);
+  if (sent.ok && sent.messageId) {
+    await rememberWhatsAppOutbound(sent.messageId, phone, text);
+  }
+  // Graph API kann 200 liefern, Zustellung scheitert später mit #131047 → Status-Webhook queued.
+  return sent;
+}
+
+async function sendWhatsAppTemplate(to, templateName, bodyParams = [], phoneIdOpt, langCode = "de") {
+  const { token } = cfg();
+  const phoneId = await resolveWhatsAppPhoneId(phoneIdOpt);
+  const phone = normWaPhone(to);
+  if (!token || !phoneId || !phone || !templateName) {
+    return { ok: false, reason: "template_not_configured" };
+  }
+  const language = process.env.WHATSAPP_TEMPLATE_LANG || langCode;
+  const components = [];
+  if (bodyParams.length) {
+    components.push({
+      type: "body",
+      parameters: bodyParams.map((p) => ({ type: "text", text: String(p).slice(0, 1024) })),
+    });
+  }
+  try {
+    const res = await fetch(`https://graph.facebook.com/v20.0/${phoneId}/messages`, {
+      method: "POST",
+      headers: { "Content-Type": "application/json", Authorization: `Bearer ${token}` },
+      body: JSON.stringify({
+        messaging_product: "whatsapp",
+        to: phone,
+        type: "template",
+        template: {
+          name: templateName,
+          language: { code: language },
+          ...(components.length ? { components } : {}),
+        },
+      }),
+    });
+    const bodyText = await res.text().catch(() => "");
+    if (!res.ok) {
+      let metaCode = null;
+      let metaMessage = null;
+      try {
+        const j = JSON.parse(bodyText);
+        metaCode = j?.error?.code ?? null;
+        metaMessage = j?.error?.message ?? null;
+      } catch (_) { /* */ }
+      await debugLog("template_send_failed", {
+        to: phone,
+        templateName,
+        status: res.status,
+        metaCode,
+        response: bodyText.slice(0, 1000),
+      });
+      return { ok: false, status: res.status, metaCode, metaMessage, error: bodyText };
+    }
+    let messageId = null;
+    try {
+      messageId = JSON.parse(bodyText)?.messages?.[0]?.id || null;
+    } catch (_) { /* */ }
+    await debugLog("template_send_ok", { to: phone, templateName, messageId });
+    return { ok: true, messageId };
+  } catch (e) {
+    logger.error("sendWhatsAppTemplate", e);
+    return { ok: false, reason: "fetch_failed", error: String(e) };
+  }
+}
+
+async function broadcast(text, meta = {}) {
   const { recipients } = cfg();
-  if (!recipients.length) return;
-  await Promise.all(recipients.map((r) => sendWhatsApp(r, text)));
+  if (!recipients.length) return { sent: 0, queued: 0, failed: 0 };
+  const results = await Promise.all(recipients.map((r) => sendWhatsAppProactive(r, text, undefined, meta)));
+  const sent = results.filter((r) => r?.ok).length;
+  const queued = results.filter((r) => r?.queued).length;
+  const failed = results.length - sent - queued;
+  if (queued || failed) {
+    await debugLog("broadcast_summary", {
+      sent,
+      queued,
+      failed,
+      preview: String(text).slice(0, 80),
+      kind: meta?.kind || null,
+    });
+  }
+  return { sent, queued, failed };
 }
 
